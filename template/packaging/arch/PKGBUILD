# Local package for own use: builds the committed HEAD of this repository.
# Usage (in this directory): makepkg -si
pkgname=__APP__-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="__TITLE__"
arch=('x86_64')
license=('GPL-3.0-or-later' 'MIT' 'OFL-1.1')
depends=('fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'libglvnd')
makedepends=('cargo' 'git')
optdepends=('libxkbcommon-x11: X11 session' 'libx11: X11 session' 'libxcursor: X11 session'
            'libxi: X11 session' 'libxrandr: X11 session')
provides=('__APP__')
conflicts=('__APP__')
options=('!lto')
source=("__APP__::git+file://${startdir%/packaging/arch}")
sha256sums=('SKIP')

pkgver() {
  cd __APP__
  local version
  version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
  printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd __APP__
  export RUSTUP_TOOLCHAIN=stable
  # Kaamos is a git dependency; the git CLI uses your credential helper.
  export CARGO_NET_GIT_FETCH_WITH_CLI=true
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd __APP__
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/build"
  cargo build --frozen --release
}

check() {
  cd __APP__
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd __APP__
  install -Dm755 target/release/__APP__ "$pkgdir/usr/bin/__APP__"
  install -Dm644 packaging/__APP__.desktop "$pkgdir/usr/share/applications/__APP__.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
