// SPDX-License-Identifier: GPL-3.0-or-later
// Kaamos gallery: every component once, in the same layout an app would use
// (sidebar + pages + bottom bar + InfoLayer).

import { ComboBox, SpinBox, Slider, ScrollView, LineEdit } from "std-widgets.slint";
import {
    Theme, NButton, NSwitch, Segmented, Card, Caps, Chip, NavItem, ValueField, Dialog,
    Hint, PageTitle, SettingRow, Section, Stat, InfoLayer,
} from "@kaamos/kaamos.slint";

component Swatch inherits VerticalLayout {
    in property <string> name;
    in property <brush> color;
    spacing: 4px;
    Rectangle {
        height: 36px;
        border-radius: Theme.radius-xs;
        border-width: 1px;
        border-color: Theme.hairline-strong;
        background: root.color;
    }
    Text {
        text: root.name;
        font-size: Theme.font-small;
        color: Theme.muted;
    }
}

export component Gallery inherits Window {
    title: "Kaamos gallery";
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: Theme.font-body;

    in-out property <int> page: 0;
    in-out property <bool> switch-a: true;
    in-out property <bool> switch-b;
    in-out property <int> segment: 1;
    in-out property <int> spin: 3;
    in-out property <float> slider: 10;
    in-out property <string> status: "Ready.";
    callback notify(string);

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 216px;
            background: Theme.panel;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.hairline;
            }
            VerticalLayout {
                padding: 14px;
                padding-top: 20px;
                spacing: 4px;
                VerticalLayout {
                    padding-left: 8px;
                    padding-bottom: 18px;
                    Text {
                        text: "Kaamos";
                        font-size: Theme.font-h2;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: "component gallery";
                        font-size: Theme.font-caps;
                        color: Theme.muted;
                    }
                }
                NavItem {
                    text: "Controls";
                    icon: @image-url("@kaamos/icons/nav-eq.svg");
                    active: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    text: "Cards";
                    icon: @image-url("@kaamos/icons/nav-setups.svg");
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    text: "Theme";
                    icon: @image-url("@kaamos/icons/nav-state.svg");
                    active: root.page == 2;
                    clicked => { root.page = 2; }
                }
                Rectangle { vertical-stretch: 1; }
                NavItem {
                    text: "Settings";
                    icon: @image-url("@kaamos/icons/nav-settings.svg");
                    active: root.page == 3;
                    clicked => { root.page = 3; }
                }
            }
        }

        // Pages
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 24px;
            padding-left: 28px;
            padding-right: 28px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 12px;
                PageTitle {
                    text: root.page == 0 ? "Controls" : root.page == 1 ? "Cards" : root.page == 2 ? "Theme" : "Settings";
                }
                Rectangle { horizontal-stretch: 1; }
                Chip {
                    text: "v0.4";
                    tone: 1;
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 16px;
                    padding-right: 6px;

                    if root.page == 0: VerticalLayout {
                        spacing: 16px;
                        Section {
                            title: "BUTTONS";
                            info-body: "NButton kind 0 = secondary, 1 = primary, 2 = quiet. `checked` shows a pressed toggle, `danger` an alarm toggle.";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                NButton {
                                    text: "Primary";
                                    kind: 1;
                                    clicked => { root.notify("Primary clicked"); }
                                }
                                NButton {
                                    text: "Secondary";
                                    clicked => { root.notify("Secondary clicked"); }
                                }
                                NButton {
                                    text: "Quiet";
                                    kind: 2;
                                }
                                NButton {
                                    text: "Checked";
                                    checked: true;
                                }
                                NButton {
                                    text: "Danger";
                                    checked: true;
                                    danger: true;
                                }
                                NButton {
                                    text: "Disabled";
                                    enabled: false;
                                }
                            }
                        }
                        Section {
                            title: "SETTING ROWS";
                            SettingRow {
                                label: "Switch";
                                hint: "NSwitch with a label";
                                info-body: "SettingRow puts the label, an optional hint and an optional (i) on the left and the control on the right.";
                                NSwitch {
                                    text: root.switch-a ? "On" : "Off";
                                    checked <=> root.switch-a;
                                }
                            }
                            SettingRow {
                                label: "Another switch";
                                NSwitch {
                                    text: root.switch-b ? "On" : "Off";
                                    checked <=> root.switch-b;
                                }
                            }
                            SettingRow {
                                label: "Segmented";
                                info-body: "Segmented: a row of mutually exclusive choices.";
                                Segmented {
                                    model: ["125", "500", "1000", "4000"];
                                    current-index <=> root.segment;
                                    item-height: 28px;
                                }
                            }
                            SettingRow {
                                label: "SpinBox (std, fluent-dark)";
                                SpinBox {
                                    value <=> root.spin;
                                    minimum: 0;
                                    maximum: 15;
                                }
                            }
                            SettingRow {
                                label: "Slider";
                                HorizontalLayout {
                                    spacing: 10px;
                                    Slider {
                                        min-width: 160px;
                                        minimum: 0;
                                        maximum: 20;
                                        value <=> root.slider;
                                    }
                                    Text {
                                        text: "\{round(root.slider)}";
                                        color: Theme.text-strong;
                                        vertical-alignment: center;
                                        min-width: 30px;
                                    }
                                }
                            }
                            SettingRow {
                                label: "ComboBox (std)";
                                ComboBox {
                                    min-width: 180px;
                                    model: ["left", "right", "backward", "forward"];
                                }
                            }
                            SettingRow {
                                label: "LineEdit (std)";
                                LineEdit {
                                    min-width: 180px;
                                    placeholder-text: "Type here";
                                }
                            }
                        }
                    }

                    if root.page == 1: VerticalLayout {
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 16px;
                            Stat {
                                label: "BATTERY";
                                value: "93 %";
                                value-color: Theme.success;
                                note: "Stat: label, value, caption";
                            }
                            Stat {
                                label: "SIGNAL";
                                value: "100 %";
                                note: "value-color is optional";
                            }
                            Stat {
                                label: "WARNING";
                                value: "18 %";
                                value-color: Theme.warning;
                                note: "Theme.warning";
                            }
                        }
                        Section {
                            title: "CHIPS";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Chip { text: "neutral"; }
                                Chip {
                                    text: "violet";
                                    tone: 1;
                                }
                                Chip {
                                    text: "warning";
                                    tone: 2;
                                }
                                Chip {
                                    text: "accent";
                                    tone: 3;
                                }
                                Chip {
                                    text: "error";
                                    tone: 4;
                                }
                            }
                        }
                        Card {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 8px;
                                Caps { text: "PLAIN CARD"; }
                                Hint { text: "Card is a surface with a hairline border and a shadow; put your own layout inside. Section adds an upper-case title and an optional (i)."; }
                            }
                        }
                    }

                    if root.page == 2: VerticalLayout {
                        spacing: 16px;
                        Section {
                            title: "GROUNDS";
                            HorizontalLayout {
                                spacing: 12px;
                                Swatch {
                                    name: "bg";
                                    color: Theme.bg;
                                }
                                Swatch {
                                    name: "panel";
                                    color: Theme.panel;
                                }
                                Swatch {
                                    name: "surface";
                                    color: Theme.surface;
                                }
                                Swatch {
                                    name: "surface-2";
                                    color: Theme.surface-2;
                                }
                                Swatch {
                                    name: "surface-3";
                                    color: Theme.surface-3;
                                }
                            }
                        }
                        Section {
                            title: "BRAND AND STATES";
                            HorizontalLayout {
                                spacing: 12px;
                                Swatch {
                                    name: "primary";
                                    color: Theme.primary;
                                }
                                Swatch {
                                    name: "brand";
                                    color: Theme.brand;
                                }
                                Swatch {
                                    name: "accent";
                                    color: Theme.accent;
                                }
                                Swatch {
                                    name: "success";
                                    color: Theme.success;
                                }
                                Swatch {
                                    name: "warning";
                                    color: Theme.warning;
                                }
                                Swatch {
                                    name: "error";
                                    color: Theme.error;
                                }
                                Swatch {
                                    name: "ring";
                                    color: Theme.ring;
                                }
                            }
                        }
                        Section {
                            title: "TYPE";
                            Text {
                                text: "Title 24";
                                font-size: Theme.font-title;
                                font-weight: 700;
                                color: Theme.text-strong;
                            }
                            Text {
                                text: "Heading 16";
                                font-size: Theme.font-h2;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: "Body 14 – Inter";
                                color: Theme.text;
                            }
                            Hint { text: "Small 12, muted"; }
                            Caps { text: "CAPS 11"; }
                        }
                    }

                    if root.page == 3: VerticalLayout {
                        spacing: 16px;
                        Section {
                            title: "VALUE FIELD";
                            info-body: "ValueField: type a value and press Enter, scroll the mouse wheel (Shift for bigger steps) or use − and +. The app validates and answers through `text`.";
                            ValueField {
                                text: "\{root.spin} ms";
                                unit: "";
                                enabled: true;
                                step(delta, big) => {
                                    root.spin = max(0, min(15, root.spin + delta * (big ? 5 : 1)));
                                }
                            }
                        }
                        Section {
                            title: "DIALOG FRAME";
                            Dialog {
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    Text {
                                        text: "Dialog";
                                        font-weight: 700;
                                        color: Theme.text-strong;
                                    }
                                    Hint { text: "A frame for popups; tone 1 = warning border."; }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom bar
            Rectangle {
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.hairline;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;
                    Text {
                        text: root.status;
                        color: Theme.muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    NButton {
                        text: "Revert";
                    }
                    NButton {
                        text: "Save";
                        kind: 1;
                        clicked => { root.notify("Saved"); }
                    }
                }
            }
        }
    }

    // Must be the last child: draws the (i) explanations on top of everything.
    InfoLayer { }
}
